# YouTube Video Statistics Pipeline Environment Configuration

# Optional: Google Cloud YouTube Data API v3 Key
# Get your key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Kaggle API Credentials (or place kaggle.json in ~/.kaggle/)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Hadoop & HDFS Configuration
# Set to 'true' if running against a live Hadoop HDFS cluster
USE_HDFS=false
HDFS_NAMENODE=hdfs://localhost:9000

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

